---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="页面不存在" description="404 - 页面不存在">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-12 relative w-full text-center">
            <div class="text-[6rem] font-bold leading-none text-90">404</div>
            <div class="mt-3 text-75 text-lg">这个页面不见了</div>
            <p class="mt-3 text-50 text-sm">可能是链接写错了，或者这篇文章已经被删掉了。</p>
            <a href="/" class="btn-regular mt-8 inline-flex items-center gap-2 px-5 py-2 rounded-lg transition">
                <Icon name="fa6-solid:house" class="w-4 h-4"></Icon>
                <span>返回首页</span>
            </a>
        </div>
    </div>
</MainGridLayout>
